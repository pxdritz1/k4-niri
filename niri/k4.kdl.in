// K4 bindings for Niri. Generated by instalar-niri.
// Check key conflicts before enabling these bindings.

spawn-at-startup "@K4_PATH@/arrancar" "--no-duplicate" "-d"

binds {
    Mod+Space { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "toggleLauncher"; }
    Mod+Shift+Space { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.apps" "toggle"; }
    Mod+I { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "togglePanel"; }
    Mod+X { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "togglePanel"; }
    Mod+N { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "toggleNotifications"; }
    Mod+A { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "toggleNotifications"; }
    Mod+Z { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "settings"; }
    Mod+Shift+W { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "theme"; }
    Mod+V { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "clipboard"; }
    Mod+B { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "files"; }
    Mod+K { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "keys"; }
    Mod+L { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "lock"; }
    Mod+Alt+C { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "session"; }
    Mod+Shift+D { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "dual"; }
    Mod+Shift+T { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.term" "isla"; }
    Mod+Alt+T { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.term" "mudar"; }
    Mod+Alt+S { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.ssh" "abrir"; }
    Mod+G { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "ask"; }
    Mod+Shift+G { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "askScreen"; }
    Mod+Alt+G { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "askRegion"; }
    Mod+Ctrl+G { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "askSelection"; }
    XF86AudioPlay { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "togglePlay"; }
    XF86AudioPause { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "togglePlay"; }
    XF86AudioNext { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "nextTrack"; }
    XF86AudioPrev { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4" "prevTrack"; }
    Mod+C { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.captura" "region"; }
    Mod+Ctrl+C { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.captura" "anotar"; }
    Mod+Print { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.captura" "menu"; }
    Print { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.captura" "region"; }
    Shift+Print { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.captura" "pantalla"; }
    Ctrl+Print { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.captura" "ventana"; }
    Mod+Shift+C { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.captura" "grabarAlternar"; }
    Mod+Shift+E { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.editor" "abrir"; }
    Mod+Alt+E { spawn "quickshell" "ipc" "-p" "@K4_PATH@/shell.qml" "call" "k4.editor" "retomar"; }
}
